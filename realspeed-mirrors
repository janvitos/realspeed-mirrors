#!/usr/bin/env bash
# realspeed-mirrors - rank Arch Linux and CachyOS pacman mirrors by downloading
# a REAL package from each candidate mirror.
#
# Copyright (C) 2026 janvitos
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Usage:
#   realspeed-mirrors             rank and write the mirrorlists in /etc/pacman.d (root)
#   realspeed-mirrors --dry-run   rank and print the result, write nothing (no root needed)
#   realspeed-mirrors --version   print version
#   realspeed-mirrors --help      this help
#
# Config: /etc/conf.d/realspeed-mirrors.conf (also reads cachyos-rate-mirrors.env)
# Docs:   https://github.com/janvitos/realspeed-mirrors

set -uo pipefail
VERSION=1.0.0

# ---- defaults (override in /etc/conf.d/realspeed-mirrors.conf) -------------
CANDIDATES=10          # mirrors per repo family taken from rate-mirrors
TEST_BYTES=20000000    # max bytes downloaded per mirror per test (~20 MB)
TEST_SECS=8            # max seconds per mirror per test
RETEST_TOP=5           # re-test this many fastest mirrors with another package; keep the lower speed
MIN_PKG=15000000       # size window for the randomly chosen test packages
MAX_PKG=100000000
# Extra candidates, tested and ranked like every other mirror (never forced to the top).
# These are the mirrors cachyos-rate-mirrors always puts first.
EXTRA_ARCH_MIRRORS=(
    'https://archlinux.cachyos.org/repo/$repo/os/$arch'
    'https://mirror.zyner.org/archlinux/$repo/os/$arch'
)
EXTRA_CACHYOS_MIRRORS=(
    'https://cdn77.cachyos.org/repo/$arch/$repo'
)
MIRROR_DIR=/etc/pacman.d
CONF=/etc/conf.d/realspeed-mirrors.conf
COMPAT_ENV=/etc/conf.d/cachyos-rate-mirrors.env

msg(){  printf ':: %s\n' "$*" >&2; }
warn(){ printf '!! %s\n' "$*" >&2; }
die(){  printf 'realspeed-mirrors: %s\n' "$*" >&2; exit 1; }
expand(){ local u=${1//\$repo/$2}; printf '%s\n' "${u//\$arch/$3}"; }
host(){ local h=${1#*://}; printf '%s\n' "${h%%/*}"; }
mbps(){ awk -v b="$1" 'BEGIN{printf "%.1f MB/s", b/1048576}'; }

usage(){ sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

DRY=0
case ${1:-} in
    "")            ;;
    -n|--dry-run)  DRY=1 ;;
    -V|--version)  echo "realspeed-mirrors $VERSION"; exit 0 ;;
    -h|--help)     usage; exit 0 ;;
    *)             usage >&2; exit 2 ;;
esac
((DRY)) || [[ $EUID -eq 0 ]] || die "writing mirrorlists needs root (or use --dry-run)"

for c in rate-mirrors curl bsdtar pacman-conf; do
    command -v "$c" >/dev/null || die "missing dependency: $c"
done

# ---- config: compat env first, own config wins ------------------------------
set -a
# shellcheck disable=SC1090
[[ -r $COMPAT_ENV ]] && . "$COMPAT_ENV"
# shellcheck disable=SC1090
[[ -r $CONF ]] && . "$CONF"
set +a
export RATE_MIRRORS_PROTOCOL=${RATE_MIRRORS_PROTOCOL:-https}
export RATE_MIRRORS_ALLOW_ROOT=true
export RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT=${RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT:-30000}
export RATE_MIRRORS_MAX_DELAY=${RATE_MIRRORS_MAX_DELAY:-10000}
# rate-mirrors only discovers candidates here; the real test ranks them. Short probes
# cut its own traffic from ~490 MB to ~200 MB per run with about the same candidates.
export RATE_MIRRORS_MIN_PER_MIRROR=${RATE_MIRRORS_MIN_PER_MIRROR:-100}
export RATE_MIRRORS_MAX_PER_MIRROR=${RATE_MIRRORS_MAX_PER_MIRROR:-300}

# Entry country: same detection as cachyos-rate-mirrors, so non-US users start near home.
if [[ -z ${RATE_MIRRORS_ENTRY_COUNTRY:-} ]]; then
    country=$(curl --connect-timeout 10 -sSL 'https://geoip.kde.org/v1/ubiquity' 2>/dev/null \
              | grep -Po '<CountryCode>\K[A-Z]{2}' || true)
    [[ -n $country ]] && export RATE_MIRRORS_ENTRY_COUNTRY=$country
fi
# China: only domestic mirrors are reachable, so test more of them and skip neighbours.
if [[ ${RATE_MIRRORS_ENTRY_COUNTRY:-} == CN ]]; then
    export RATE_MIRRORS_COUNTRY_NEIGHBORS_PER_COUNTRY=${RATE_MIRRORS_COUNTRY_NEIGHBORS_PER_COUNTRY:-0}
    export RATE_MIRRORS_COUNTRY_TEST_MIRRORS_PER_COUNTRY=${RATE_MIRRORS_COUNTRY_TEST_MIRRORS_PER_COUNTRY:-50}
fi
msg "entry country: ${RATE_MIRRORS_ENTRY_COUNTRY:-not detected (rate-mirrors default)}"

TMP=$(mktemp -d) || die "mktemp failed"
trap 'rm -rf -- "$TMP"' EXIT

# ---- one instance at a time, and never while pacman is running --------------
if ((!DRY)); then
    exec 9>/run/lock/realspeed-mirrors.lock || die "cannot open lock file"
    flock -n 9 || die "another realspeed-mirrors is already running"
    lck="$(pacman-conf DBPath)db.lck"
    for ((i = 0; i < 60; i++)); do
        [[ -e $lck ]] || break
        ((i == 0)) && msg "pacman is running, waiting for it to finish..."
        sleep 10
    done
    [[ -e $lck ]] && die "pacman still running after 10 minutes ($lck), mirrorlists left unchanged"
fi

# speedtest <url> -> bytes/s on stdout (0 = failed / file missing)
# The byte cap is enforced locally (head -c): some mirrors ignore Range and
# send the whole package, which would otherwise run until TEST_SECS.
speedtest(){
    local code=0 sp=0
    read -r code sp < <( { curl -s -r "0-$((TEST_BYTES - 1))" -m "$TEST_SECS" --connect-timeout 5 \
                             -w '%{stderr}%{http_code} %{speed_download}\n' "$1" \
                           | head -c "$TEST_BYTES" >/dev/null; } 2>&1 )
    [[ $code == 200 || $code == 206 ]] || sp=0
    printf '%.0f\n' "${sp:-0}"
}

# rank <rate-mirrors kind> <repo> <arch path> <current mirrorlist> <extra mirror...>
# stdout: "<bytes/s>\t<server template>" for working mirrors, fastest first
rank(){
    local kind=$1 repo=$2 arch=$3 current=$4; shift 4
    local -a servers pkgs sp order
    local s u i n pkg1 pkg2
    local -A seen=()

    mapfile -t servers < <(rate-mirrors --disable-comments --max-mirrors-to-output "$CANDIDATES" "$kind" \
                           2>/dev/null | sed -n 's/^Server *= *//p')
    if ((${#servers[@]} == 0)); then
        warn "[$kind] rate-mirrors returned nothing, falling back to the current $current"
        mapfile -t servers < <(sed -n 's/^Server *= *//p' "$current" 2>/dev/null)
    fi
    servers+=("$@")
    # de-duplicate by host, keep first occurrence
    local -a uniq=()
    for s in "${servers[@]}"; do
        u=$(host "$s"); [[ -n ${seen[$u]:-} ]] && continue
        seen[$u]=1; uniq+=("$s")
    done
    servers=("${uniq[@]}")
    ((${#servers[@]})) || { warn "[$kind] no candidate mirrors"; return 1; }

    # Fresh repo database -> list of real packages in the size window.
    for s in "${servers[@]}"; do
        u=$(expand "$s" "$repo" "$arch")
        curl -fsS -m 60 -o "$TMP/$repo.db" "$u/$repo.db" 2>/dev/null || continue
        mapfile -t pkgs < <(bsdtar -xOf "$TMP/$repo.db" '*/desc' 2>/dev/null | awk -v lo="$MIN_PKG" -v hi="$MAX_PKG" '
            /^%FILENAME%$/ {getline fn}
            /^%CSIZE%$/    {getline cs; if (cs+0 >= lo && cs+0 <= hi) print fn}')
        ((${#pkgs[@]})) && break
    done
    ((${#pkgs[@]})) || { warn "[$kind] could not read $repo.db from any candidate"; return 1; }
    # Random packages, so no mirror is judged on a file it happens to have hot in cache.
    pkg1=${pkgs[RANDOM % ${#pkgs[@]}]}
    pkg2=${pkgs[RANDOM % ${#pkgs[@]}]}

    msg "[$kind] testing ${#servers[@]} mirrors with $repo/$pkg1"
    for i in "${!servers[@]}"; do
        sp[i]=$(speedtest "$(expand "${servers[i]}" "$repo" "$arch")/$pkg1")
        if ((sp[i] > 0)); then printf '   %12s  %s\n' "$(mbps "${sp[i]}")" "$(host "${servers[i]}")" >&2
        else printf '   %12s  %s\n' "FAILED" "$(host "${servers[i]}")" >&2; fi
    done

    if ((RETEST_TOP > 0)); then
        mapfile -t order < <(for i in "${!sp[@]}"; do ((sp[i] > 0)) && printf '%s %s\n' "${sp[i]}" "$i"; done \
                             | sort -k1,1nr | head -n "$RETEST_TOP" | cut -d' ' -f2)
        ((${#order[@]})) && msg "[$kind] re-testing top ${#order[@]} with $repo/$pkg2"
        for i in "${order[@]}"; do
            n=$(speedtest "$(expand "${servers[i]}" "$repo" "$arch")/$pkg2")
            printf '   %12s  %s\n' "$( ((n > 0)) && mbps "$n" || echo FAILED)" "$(host "${servers[i]}")" >&2
            ((n < sp[i])) && sp[i]=$n
        done
    fi

    for i in "${!servers[@]}"; do
        ((sp[i] > 0)) && printf '%s\t%s\n' "${sp[i]}" "${servers[i]}"
    done | sort -t$'\t' -k1,1nr
}

# emit <ranked lines> -> mirrorlist text
emit(){
    printf '# Generated by realspeed-mirrors %s on %s\n' "$VERSION" "$(date -Is)"
    printf '# Ordered by measured download speed of real packages (slower of two tests for the top mirrors)\n\n'
    local sp s
    while IFS=$'\t' read -r sp s; do
        printf '## %s\nServer = %s\n' "$(mbps "$sp")" "$s"
    done <<<"$1"
}

# put <file> <content>
put(){
    if ((DRY)); then printf '\n===== %s (dry run, not written) =====\n%s\n' "$1" "$2"; return 0; fi
    printf '%s\n' "$2" > "$TMP/out" || return 1
    install -m 0644 --backup=simple --suffix=-backup "$TMP/out" "$1" && msg "wrote $1"
}

repos=$(pacman-conf --repo-list)
status=0

# ---- Arch Linux --------------------------------------------------------------
if grep -qxE 'core|extra' <<<"$repos"; then
    if ranked=$(rank arch extra x86_64 "$MIRROR_DIR/mirrorlist" "${EXTRA_ARCH_MIRRORS[@]}") && [[ -n $ranked ]]; then
        put "$MIRROR_DIR/mirrorlist" "$(emit "$ranked")" || status=1
    else
        status=1; warn "no working Arch mirrors measured, $MIRROR_DIR/mirrorlist left unchanged"
    fi
fi

# ---- CachyOS: test the most specific repo this system actually uses ---------
if grep -qE '^cachyos' <<<"$repos"; then
    if   c_repo=$(grep -m1 -xE 'cachyos-extra-(znver4|v4)' <<<"$repos"); then c_arch=x86_64_v4
    elif c_repo=$(grep -m1 -x  'cachyos-extra-v3'          <<<"$repos"); then c_arch=x86_64_v3
    else c_repo=cachyos; c_arch=x86_64; fi
    if ranked=$(rank cachyos "$c_repo" "$c_arch" "$MIRROR_DIR/cachyos-mirrorlist" "${EXTRA_CACHYOS_MIRRORS[@]}") \
       && [[ -n $ranked ]]; then
        list=$(emit "$ranked")
        put "$MIRROR_DIR/cachyos-mirrorlist" "$list" || status=1
        for v in v3 v4; do
            [[ -f $MIRROR_DIR/cachyos-$v-mirrorlist ]] || continue
            put "$MIRROR_DIR/cachyos-$v-mirrorlist" "$(sed "s|/\$arch/|/\$arch_$v/|g" <<<"$list")" || status=1
        done
    else
        status=1; warn "no working CachyOS mirrors measured, CachyOS mirrorlists left unchanged"
    fi
fi

exit "$status"
